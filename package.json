{
  "name": "supermarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UK meal planning that turns a week of dinners into one consolidated grocery basket",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:host": "node scripts/start.mjs --host",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "server:mock": "node server/index.mjs --mock",
    "tesco:import": "node scripts/connect-tesco.mjs",
    "capture": "node scripts/retired-capture.mjs",
    "refresh": "node scripts/connect-tesco.mjs",
    "connect": "node scripts/connect-tesco.mjs",
    "narrow": "node scripts/narrow-config.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "open-supermarkets": "3.0.0",
    "playwright": "1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "patch-package": "8.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
