{
  "manifest_version": 3,
  "name": "Supermarket Tesco Connect",
  "version": "0.1.1",
  "description": "Keeps Supermarket connected to Tesco on this computer.",
  "permissions": [
    "webRequest",
    "cookies",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.tesco.com/*",
    "https://xapi.tesco.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}
