{
  "manifest_version": 3,
  "name": "Supermarket Tesco Connect",
  "version": "0.2.0",
  "description": "Plan the week and fill your Tesco basket, with nothing else to run.",
  "permissions": [
    "webRequest",
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.tesco.com/*",
    "https://xapi.tesco.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Supermarket"
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "app/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tesco.com/*"
      ],
      "js": [
        "watch-tesco.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tesco.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
